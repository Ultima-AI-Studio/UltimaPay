+def _attach_pay_identity(result):
+    """Attach a username-scoped Pay assertion without exposing the shared secret."""
+    status, response = result
+    if status != 200 or not ULTIMAPAY_USER_AUTH_SECRET or not isinstance(response, dict):
+        return result
+    data = response.get('data') or {}
+    user = data.get('user') or {}
+    username = user.get('username') or ''
+    if username:
+        user['paySignature'] = hmac.new(
+            ULTIMAPAY_USER_AUTH_SECRET.encode('utf-8'),
+            username.encode('utf-8'),
+            hashlib.sha256,
+        ).hexdigest()
+    return status, response
 
 
 
