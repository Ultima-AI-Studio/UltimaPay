-        is_legacy = (o['source'] or '') in LEGACY_SOURCES or o['amount_units'] is None
-
-        # 1) 历史未核验记录：legacy（不计入真实收入/通过率；不把历史模拟核销当真实到账）
-        if is_legacy:
